# 从源码树启动。不设置 GI_TYPELIB_PATH，使用系统已安装的 typelib。
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT" || exit 1
python3 "$ROOT/debian/render-icon.py" "$ROOT/icon.png"
# 这套 Qt 5.15 在 Wayland 上编译界面缓存会段错误。关掉缓存即可正常启动。
export QML_DISABLE_DISK_CACHE=1
exec -a netease-music /usr/bin/python3 -m qt.app "$@"
